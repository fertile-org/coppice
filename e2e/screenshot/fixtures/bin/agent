#!/bin/sh
# Stub Cursor CLI for the docs screenshot harness.
# Prints a fixed model list. It is not a signed-in Cursor session and does not
# read a host login, keychain, or credential file.
case "${1:-}" in
  models|--list-models)
    cat <<'EOF'
Available models

auto - Auto (current, default)
gpt-5.3-codex-low - Codex 5.3 Low
composer-2.5 - Composer 2.5
claude-opus-5-thinking-high - Claude Opus 5 1M Thinking
grok-4.7-low - Grok 4.7 Low
cursor-grok-4.6-low-fast - Grok 4.6 Low Fast
EOF
    ;;
  *)
    printf '%s\n' 'agent 1.0.0'
    ;;
esac
