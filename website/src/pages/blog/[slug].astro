---
import BlogArticle from '../../components/BlogArticle.astro';
import { entryFor, englishEntries } from '../../lib/blog-runtime';
import { useI18n } from '../../i18n/runtime';

export function getStaticPaths() {
  return englishEntries().map((entry) => ({
    params: { slug: entry.post.slug },
    props: { slug: entry.post.slug },
  }));
}

const { slug } = Astro.props;
const ctx = useI18n(Astro);
const english = entryFor('en', slug);
if (!english) throw new Error(`missing English blog article ${slug}`);
const translated = ctx.translated && ctx.locale !== 'en' ? entryFor(ctx.locale, slug) : null;
const entry = translated ?? english;
---

<BlogArticle post={entry.post} Content={entry.Content} />
