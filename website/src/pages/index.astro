---
import Base from '../layouts/Base.astro';
import DownloadLinks from '../components/DownloadLinks.astro';
import HeroMedia from '../components/HeroMedia.astro';
import { withBase } from '../lib/url';

const description =
  'Run several coding agents at once without babysitting them. Review every diff before it counts. Local, open source, with the agent CLIs you already pay for.';

const reasons = [
  [
    'Stop tab-hopping between terminals.',
    "Every agent's work is a card on one board. Blocked tickets and work waiting for your review stand out, so you know where you're needed.",
  ],
  [
    'Catch mistakes before they land.',
    'Every change waits for you as a diff in the app. Nothing counts as done until you accept it.',
  ],
  [
    'No second subscription.',
    'Coppice drives the CLIs you already pay for: Claude Code, Codex, Cursor, OpenCode and Kilo Code.',
  ],
  [
    'No Coppice cloud.',
    'Your repos, tickets and history stay on your machine. Only your CLIs talk to their own model providers.',
  ],
];
---

<Base title="Coppice" description={description}>
  <div class="shell landing">
    <header class="promise">
      <h1>Run a team of coding agents without babysitting them.</h1>
      <p class="lede">
        Queue work as tickets. Claude Code, Codex and the others build in parallel, each on its own branch. You
        step in to review the diff, and nothing counts as done until you accept it.
      </p>
    </header>

    <HeroMedia />

    <p class="hero-support">Open source (Apache 2.0). Runs locally, no Coppice account needed.</p>

    <div id="download">
      <DownloadLinks showDocs />
    </div>

    <section class="block" aria-labelledby="how-it-works">
      <h2 id="how-it-works">How it works</h2>
      <ol class="steps">
        <li>
          <div>
            <p>
              <strong>Hand off the work.</strong> Write a ticket, or approve one an agent suggests, and move it to Ready.
            </p>
            <p class="coming-soon">
              (Plan Review coming soon: a PM agent will draft the plan first, and you'll approve it before anyone writes
              code.)
            </p>
          </div>
        </li>
        <li>
          <p>
            <strong>Let agents build.</strong> Each ticket gets its own git worktree, so parallel agents never touch your
            main checkout. Follow any run live.
          </p>
        </li>
        <li>
          <p>
            <strong>Human Review.</strong> Read the diff in the app, comment on any line, and nothing counts as done until
            you accept it.
          </p>
        </li>
      </ol>
      <p>Download, open, work. Nothing to set up: no Docker, no Coppice account.</p>
    </section>

    <section class="block" aria-labelledby="why">
      <h2 id="why">Why Coppice</h2>
      <div class="feature-grid">
        {
          reasons.map(([title, body]) => (
            <article>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="block pair-follow" aria-labelledby="what-it-is-not">
      <h2 id="what-it-is-not">What it is not</h2>
      <ul class="plain-list">
        <li>Not a cloud coding service</li>
        <li>Not a Jira replacement</li>
        <li>Not “tell the agent and get the finished product”</li>
      </ul>
    </section>

    <section class="block" aria-labelledby="get-started">
      <h2 id="get-started">Get started</h2>
      <p>
        For engineers and small teams who already run coding agents and want to hand off more work without losing
        control of what ships.
      </p>
      <DownloadLinks />
      <p class="closer">Put your agents on a board. Keep the gates.</p>
      <p class="closer-links">
        <a href={withBase('/docs')}>Docs</a>
        <span aria-hidden="true">·</span>
        <a href="https://github.com/fertile-org/coppice">GitHub</a>
      </p>
    </section>
  </div>
</Base>
