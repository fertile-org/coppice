---
import DocsSearch from '../components/DocsSearch.astro';
import { AGENT_CLIS } from '../content/agents';
import { docOverride } from '../i18n/translations';
import { hrefFor, useI18n } from '../i18n/runtime';
import { docsSchema } from '../lib/page-schema';
import Base from './Base.astro';

interface Props {
  frontmatter: {
    title: string;
    /** Longer `<title>` for search results. `title` stays the heading in breadcrumbs. */
    metaTitle?: string;
    description: string;
  };
}

const { frontmatter } = Astro.props;
const ctx = useI18n(Astro);
const translation = ctx.rewritten ? docOverride(ctx.locale, ctx.englishPath) : null;
const Translation = translation?.Content;
const title = translation?.title || frontmatter.title;
const metaTitle = (translation ? translation.metaTitle : frontmatter.metaTitle) || title;
const description = translation?.description || frontmatter.description;
const indexed = ctx.translated;

const topLevel = [
  { href: '/docs/install', label: ctx.ui.docs.install },
  { href: '/docs/getting-started', label: ctx.ui.docs.gettingStarted },
  { href: '/docs/concepts', label: ctx.ui.docs.concepts },
  { href: '/docs/providers', label: ctx.ui.docs.providers },
  { href: '/docs/plugins', label: ctx.ui.docs.plugins },
  { href: '/docs/faq', label: ctx.ui.docs.faq },
];

const advanced = [
  { href: '/docs/settings', label: ctx.ui.docs.settings },
  { href: '/docs/shortcuts', label: ctx.ui.docs.shortcuts },
  { href: '/docs/backup', label: ctx.ui.docs.backup },
];

const advancedOpen = advanced.some((link) => ctx.englishPath === link.href);

// Reading order for previous / next: the docs home, then the sidebar from top to bottom.
const sequence = [{ href: '/docs', label: ctx.ui.nav.docs }, ...topLevel, ...advanced];
const position = sequence.findIndex((link) => link.href === ctx.englishPath);
const previous = position > 0 ? sequence[position - 1] : null;
const next = position >= 0 && position < sequence.length - 1 ? sequence[position + 1] : null;
const agentTags = ctx.englishPath === '/docs/providers' ? AGENT_CLIS : [];
---

<Base
  title={metaTitle}
  description={description}
  ogType="article"
  structuredData={docsSchema(Astro, ctx, title, description)}
  keywords={agentTags}
  tags={agentTags}
>
  <div class="shell docs-shell">
    <header class="docs-header" data-pagefind-ignore>
      <DocsSearch
        placeholder={ctx.ui.search.placeholder}
        label={ctx.ui.search.label}
        hint={ctx.ui.search.hint}
        footer={ctx.ui.search.footer}
        close={ctx.ui.search.close}
      />
    </header>
    <nav class="docs-nav" data-pagefind-ignore aria-label={ctx.ui.docs.navLabel}>
      {
        topLevel.map((link) => {
          const href = hrefFor(ctx.locale, link.href);
          const current = ctx.englishPath === link.href;
          return (
            <a href={href} aria-current={current ? 'page' : undefined}>
              {link.label}
            </a>
          );
        })
      }
      <div class="docs-nav-group">
        <button
          type="button"
          class="docs-nav-toggle"
          aria-expanded={advancedOpen ? 'true' : 'false'}
          aria-controls="docs-nav-advanced"
        >
          {ctx.ui.docs.advanced}
        </button>
        <div id="docs-nav-advanced" class="docs-nav-sub" hidden={!advancedOpen}>
          {
            advanced.map((link) => {
              const href = hrefFor(ctx.locale, link.href);
              const current = ctx.englishPath === link.href;
              return (
                <a href={href} aria-current={current ? 'page' : undefined}>
                  {link.label}
                </a>
              );
            })
          }
        </div>
      </div>
    </nav>
    <div class="docs-content">
      <nav class="docs-breadcrumbs" data-pagefind-ignore aria-label={ctx.ui.docs.breadcrumbLabel}>
        <ol>
          <li><a href={hrefFor(ctx.locale, '/')}>Coppice</a></li>
          {
            ctx.englishPath === '/docs' ? (
              <li aria-current="page">{ctx.ui.nav.docs}</li>
            ) : (
              <>
                <li><a href={hrefFor(ctx.locale, '/docs')}>{ctx.ui.nav.docs}</a></li>
                <li aria-current="page">{title}</li>
              </>
            )
          }
        </ol>
      </nav>
      {
        indexed ? (
          <article class="prose" data-pagefind-body>
            {Translation ? <Translation /> : <slot />}
          </article>
        ) : (
          <article class="prose" lang="en">
            <slot />
          </article>
        )
      }
      {
        (previous || next) && (
          <nav class="docs-pager" data-pagefind-ignore aria-label={ctx.ui.docs.pagerLabel}>
            {previous && (
              <a class="docs-pager-previous" href={hrefFor(ctx.locale, previous.href)} rel="prev">
                <span>{ctx.ui.docs.previous}</span>
                {previous.label}
              </a>
            )}
            {next && (
              <a class="docs-pager-next" href={hrefFor(ctx.locale, next.href)} rel="next">
                <span>{ctx.ui.docs.next}</span>
                {next.label}
              </a>
            )}
          </nav>
        )
      }
    </div>
  </div>
</Base>

<script>
  const toggle = document.querySelector('.docs-nav-toggle');
  const panel = document.getElementById('docs-nav-advanced');
  if (toggle instanceof HTMLButtonElement && panel) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    });
  }
</script>
