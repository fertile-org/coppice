---
import DocsSearch from '../components/DocsSearch.astro';
import Base from './Base.astro';
import { withBase } from '../lib/url';

interface Props {
  frontmatter: {
    title: string;
    description: string;
  };
}

const { frontmatter } = Astro.props;
// `build.format: 'file'` renders `/docs/shortcuts.html`. Compare the clean URL.
const pathname = (Astro.url.pathname.replace(/\/$/, '') || '/').replace(/\.html$/, '') || '/';

const topLevel = [
  { href: '/docs/install', label: 'Install' },
  { href: '/docs/getting-started', label: 'Getting started' },
  { href: '/docs/concepts', label: 'Concepts' },
  { href: '/docs/chat', label: 'Chat with agents' },
  { href: '/docs/providers', label: 'Providers' },
  { href: '/docs/plugins', label: 'Plugins' },
  { href: '/docs/faq', label: 'FAQ' },
];

// One object per page.
const advanced = [
  { href: '/docs/settings', label: 'Settings' },
  { href: '/docs/shortcuts', label: 'Keyboard shortcuts' },
  { href: '/docs/backup', label: 'Backup data' },
];

function linkHref(href: string) {
  return withBase(href).replace(/\/$/, '');
}

const advancedOpen = advanced.some((link) => pathname === linkHref(link.href));
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <div class="shell docs-shell">
    <header class="docs-header" data-pagefind-ignore>
      <DocsSearch />
    </header>
    <nav class="docs-nav" data-pagefind-ignore aria-label="Documentation">
      {
        topLevel.map((link) => {
          const href = linkHref(link.href);
          const current = pathname === href;
          return (
            <a href={href} aria-current={current ? 'page' : undefined}>
              {link.label}
            </a>
          );
        })
      }
      <div class="docs-nav-group">
        <button
          type="button"
          class="docs-nav-toggle"
          aria-expanded={advancedOpen ? 'true' : 'false'}
          aria-controls="docs-nav-advanced"
        >
          Advanced
        </button>
        <div id="docs-nav-advanced" class="docs-nav-sub" hidden={!advancedOpen}>
          {
            advanced.map((link) => {
              const href = linkHref(link.href);
              const current = pathname === href;
              return (
                <a href={href} aria-current={current ? 'page' : undefined}>
                  {link.label}
                </a>
              );
            })
          }
        </div>
      </div>
    </nav>
    <article class="prose" data-pagefind-body>
      <slot />
    </article>
  </div>
</Base>

<script>
  const toggle = document.querySelector('.docs-nav-toggle');
  const panel = document.getElementById('docs-nav-advanced');
  if (toggle instanceof HTMLButtonElement && panel) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    });
  }
</script>
