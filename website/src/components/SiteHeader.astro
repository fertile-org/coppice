---
import { withBase } from '../lib/url';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const docsPath = withBase('/docs').replace(/\/$/, '') || '/docs';
const docsActive = pathname === docsPath || pathname.startsWith(`${docsPath}/`);
const homePath = withBase('/').replace(/\/$/, '') || '/';
const homeActive = pathname === homePath;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class:list={['brand', { active: homeActive }]} href={withBase('/')}>
      <img class="mark" src={withBase('/favicon.svg')} width="34" height="36" alt="" />
      <span>Coppice</span>
    </a>
    <nav class="primary-nav" aria-label="Primary">
      <a href={withBase('/docs')} aria-current={docsActive ? 'page' : undefined}>Docs</a>
      <a href="https://github.com/fertile-org/coppice">GitHub</a>
      <a class="btn btn-small" href={withBase('/#download')}>Download</a>
    </nav>
  </div>
</header>
