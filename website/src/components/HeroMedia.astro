---
import { withBase } from '../lib/url';

const videoAlt =
  'Coppice: write a ticket, approve the plan a PM agent drafts, let agents build and test, then comment on the diff. Nothing is done until you accept it.';
const stillAlt = 'Coppice board with tickets for the acme-web repository';

const captions = [
  'Write a ticket.',
  'Your PM agent drafts a plan.',
  'You approve it.',
  'Agents build, review, and test.',
  'Review the diff. Comment on any line.',
  'Nothing is done until you accept it.',
];
---

<figure class="hero-shot">
  <div class="hero-frame">
    <img
      class="hero-still"
      src={withBase('/assets/hero-screenshot.png')}
      width="1440"
      height="900"
      alt={stillAlt}
    />
    <video
      class="hero-video"
      width="1440"
      height="900"
      muted
      loop
      playsinline
      preload="none"
      poster={withBase('/assets/hero-screenshot.png')}
      aria-label={videoAlt}
    >
      <source src={withBase('/assets/marketing.webm')} type="video/webm" />
      <source src={withBase('/assets/marketing.mp4')} type="video/mp4" />
      <img src={withBase('/assets/marketing.gif')} width="960" height="600" alt={videoAlt} />
    </video>
    <div class="hero-progress" aria-hidden="true">
      <span class="hero-progress-fill"></span>
    </div>
  </div>
  <figcaption>
    <ol class="hero-captions">
      {
        captions.map((caption) => {
          const splitAt = caption.indexOf(': ');
          if (splitAt === -1) return <li>{caption}</li>;
          const label = caption.slice(0, splitAt + 1);
          const rest = caption.slice(splitAt + 1);
          return (
            <li>
              <strong>{label}</strong>
              {rest}
            </li>
          );
        })
      }
    </ol>
  </figcaption>
</figure>
<script is:inline>
  const video = document.querySelector('.hero-video');
  const shot = document.querySelector('.hero-shot');
  const fill = document.querySelector('.hero-progress-fill');
  if (video && shot && fill) {
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;

    const paint = () => {
      const duration = video.duration;
      const ratio =
        Number.isFinite(duration) && duration > 0
          ? Math.min(1, Math.max(0, video.currentTime / duration))
          : 0;
      fill.style.width = ratio * 100 + '%';
    };

    const stop = () => {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
    };

    const tick = () => {
      paint();
      frame = requestAnimationFrame(tick);
    };

    const start = () => {
      if (motion.matches || frame) return;
      frame = requestAnimationFrame(tick);
    };

    const setPlaying = (playing) => {
      shot.classList.toggle('is-playing', playing && !motion.matches);
    };

    const sync = () => {
      if (motion.matches) {
        video.autoplay = false;
        video.preload = 'none';
        video.pause();
        stop();
        setPlaying(false);
        fill.style.width = '0%';
        return;
      }
      video.muted = true;
      video.preload = 'auto';
      const play = video.play();
      if (play && typeof play.catch === 'function') play.catch(() => {});
      if (!video.paused) {
        setPlaying(true);
        start();
      }
    };

    video.addEventListener('play', () => {
      if (motion.matches) {
        video.pause();
        return;
      }
      paint();
      setPlaying(true);
      start();
    });
    video.addEventListener('pause', () => {
      stop();
      paint();
      setPlaying(false);
    });
    video.addEventListener('seeked', paint);
    video.addEventListener('ended', () => {
      fill.style.width = '0%';
    });

    sync();
    motion.addEventListener('change', sync);
  }
</script>
