---
import {
  heroPoster,
  heroScreenshot,
  heroStillAvif,
  heroStillWebp,
  marketingGif,
  marketingMp4,
  marketingWebm,
} from '../lib/hero-assets';
import { withBase } from '../lib/url';

interface Props {
  stillAlt: string;
  videoAlt: string;
  captions: readonly string[];
}

const { stillAlt, videoAlt, captions } = Astro.props;
const sizes = '(min-width: 1112px) 1080px, calc(100vw - 2rem)';
const srcset = (list: string) =>
  list
    .split(', ')
    .map((item) => {
      const [url, width] = item.split(' ');
      return `${withBase(url)} ${width}`;
    })
    .join(', ');
---

<figure class="hero-shot">
  <div class="hero-frame">
    <!-- Shown only with reduced motion. Lazy, so a hidden still is never fetched. -->
    <picture>
      <source type="image/avif" srcset={srcset(heroStillAvif)} sizes={sizes} />
      <source type="image/webp" srcset={srcset(heroStillWebp)} sizes={sizes} />
      <img
        class="hero-still"
        src={withBase(heroScreenshot)}
        width="1440"
        height="900"
        alt={stillAlt}
        loading="lazy"
        decoding="async"
      />
    </picture>
    <video
      class="hero-video"
      width="1440"
      height="900"
      muted
      loop
      playsinline
      preload="none"
      poster={withBase(heroPoster)}
      aria-label={videoAlt}
    >
      <source src={withBase(marketingWebm)} type="video/webm" />
      <source src={withBase(marketingMp4)} type="video/mp4" />
      <!-- Fallback for browsers without <video>. Lazy, or every visitor downloads the 2.5 MB GIF. -->
      <img src={withBase(marketingGif)} width="960" height="600" alt={videoAlt} loading="lazy" />
    </video>
    <div class="hero-progress" aria-hidden="true">
      <span class="hero-progress-fill"></span>
    </div>
  </div>
  <figcaption>
    <ol class="hero-captions">
      {
        captions.map((caption) => {
          const splitAt = caption.indexOf(': ');
          if (splitAt === -1) return <li>{caption}</li>;
          const label = caption.slice(0, splitAt + 1);
          const rest = caption.slice(splitAt + 1);
          return (
            <li>
              <strong>{label}</strong>
              {rest}
            </li>
          );
        })
      }
    </ol>
  </figcaption>
</figure>
<script is:inline>
  const video = document.querySelector('.hero-video');
  const shot = document.querySelector('.hero-shot');
  const fill = document.querySelector('.hero-progress-fill');
  if (video && shot && fill) {
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;

    const paint = () => {
      const duration = video.duration;
      const ratio =
        Number.isFinite(duration) && duration > 0
          ? Math.min(1, Math.max(0, video.currentTime / duration))
          : 0;
      fill.style.width = ratio * 100 + '%';
    };

    const stop = () => {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
    };

    const tick = () => {
      paint();
      frame = requestAnimationFrame(tick);
    };

    const start = () => {
      if (motion.matches || frame) return;
      frame = requestAnimationFrame(tick);
    };

    const setPlaying = (playing) => {
      shot.classList.toggle('is-playing', playing && !motion.matches);
    };

    const sync = () => {
      if (motion.matches) {
        video.autoplay = false;
        video.preload = 'none';
        video.pause();
        stop();
        setPlaying(false);
        fill.style.width = '0%';
        return;
      }
      video.muted = true;
      video.preload = 'auto';
      const play = video.play();
      if (play && typeof play.catch === 'function') play.catch(() => {});
      if (!video.paused) {
        setPlaying(true);
        start();
      }
    };

    video.addEventListener('play', () => {
      if (motion.matches) {
        video.pause();
        return;
      }
      paint();
      setPlaying(true);
      start();
    });
    video.addEventListener('pause', () => {
      stop();
      paint();
      setPlaying(false);
    });
    video.addEventListener('seeked', paint);
    video.addEventListener('ended', () => {
      fill.style.width = '0%';
    });

    sync();
    motion.addEventListener('change', sync);
  }
</script>
