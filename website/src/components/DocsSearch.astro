---
import { SEARCH_HINT, SEARCH_LABEL, SEARCH_PLACEHOLDER } from '../lib/docs-search';
---

<div class="docs-search" data-pagefind-ignore>
  <label class="visually-hidden" for="docs-search">{SEARCH_LABEL}</label>
  <div class="docs-search-control">
    <input
      id="docs-search"
      class="docs-search-input"
      type="search"
      placeholder={SEARCH_PLACEHOLDER}
      aria-label={SEARCH_LABEL}
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls="docs-search-results"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="search"
    />
    <kbd class="docs-search-hint" aria-hidden="true">{SEARCH_HINT}</kbd>
  </div>
  <div id="docs-search-results" class="docs-search-panel" hidden></div>
</div>

<script>
  import { moveResultIndex, noResultsMessage, resultHref, slashShouldFocus } from '../lib/docs-search';

  const root = document.querySelector('.docs-search');
  const input = root?.querySelector('.docs-search-input');
  const panel = root?.querySelector('.docs-search-panel');

  if (root instanceof HTMLElement && input instanceof HTMLInputElement && panel instanceof HTMLElement) {
    const RESULT_LIMIT = 8;
    let pagefindPromise: Promise<PagefindModule> | null = null;
    let requestId = 0;
    let activeIndex = -1;
    let debounceTimer = 0;

    type PagefindResult = {
      url: string;
      excerpt: string;
      meta?: { title?: string };
    };

    type PagefindModule = {
      options?: (options: { bundlePath?: string }) => Promise<void>;
      search: (query: string) => Promise<{
        results: Array<{ data: () => Promise<PagefindResult> }>;
      }>;
    };

    function bundleDir(): string {
      const base = import.meta.env.BASE_URL || '/';
      return `${base.endsWith('/') ? base : `${base}/`}pagefind/`;
    }

    function loadPagefind(): Promise<PagefindModule> {
      if (!pagefindPromise) {
        const dir = bundleDir();
        pagefindPromise = import(/* @vite-ignore */ `${dir}pagefind.js`)
          .then(async (mod: { default?: PagefindModule } & Partial<PagefindModule>) => {
            const pagefind = (mod.default ?? mod) as PagefindModule;
            if (pagefind.options) await pagefind.options({ bundlePath: dir });
            return pagefind;
          })
          .catch((error: unknown) => {
            pagefindPromise = null;
            throw error;
          });
      }
      return pagefindPromise;
    }

    function setExpanded(open: boolean) {
      input.setAttribute('aria-expanded', open ? 'true' : 'false');
      panel.hidden = !open;
      if (!open) {
        activeIndex = -1;
        input.removeAttribute('aria-activedescendant');
      }
    }

    function selectResult(index: number) {
      const options = [...panel.querySelectorAll<HTMLElement>('[role="option"]')];
      activeIndex = index;
      options.forEach((option, optionIndex) => {
        const selected = optionIndex === index;
        option.setAttribute('aria-selected', selected ? 'true' : 'false');
        if (selected) input.setAttribute('aria-activedescendant', option.id);
      });
      options[index]?.scrollIntoView({ block: 'nearest' });
    }

    function renderResults(query: string, results: PagefindResult[]) {
      panel.replaceChildren();
      activeIndex = -1;
      input.removeAttribute('aria-activedescendant');

      if (results.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'docs-search-empty';
        empty.setAttribute('role', 'status');
        empty.textContent = noResultsMessage(query);
        panel.append(empty);
        setExpanded(true);
        return;
      }

      const list = document.createElement('div');
      list.className = 'docs-search-list';
      list.setAttribute('role', 'listbox');
      const base = import.meta.env.BASE_URL || '/';
      results.forEach((result, index) => {
        const link = document.createElement('a');
        link.className = 'docs-search-result';
        link.id = `docs-search-result-${index}`;
        link.href = resultHref(result.url, base);
        link.setAttribute('role', 'option');
        link.setAttribute('aria-selected', 'false');

        const title = document.createElement('span');
        title.className = 'docs-search-result-title';
        title.textContent = result.meta?.title?.trim() || link.href;

        const excerpt = document.createElement('span');
        excerpt.className = 'docs-search-result-excerpt';
        excerpt.innerHTML = result.excerpt;

        link.append(title, excerpt);
        link.addEventListener('pointermove', () => selectResult(index));
        list.append(link);
      });
      panel.append(list);
      setExpanded(true);
    }

    async function runSearch(query: string) {
      const id = ++requestId;
      try {
        const pagefind = await loadPagefind();
        const search = await pagefind.search(query);
        if (id !== requestId) return;
        const data = await Promise.all(search.results.slice(0, RESULT_LIMIT).map((result) => result.data()));
        if (id !== requestId) return;
        renderResults(query, data);
      } catch (error) {
        if (id !== requestId) return;
        console.error(error);
        panel.replaceChildren();
        setExpanded(false);
      }
    }

    input.addEventListener('input', () => {
      window.clearTimeout(debounceTimer);
      const query = input.value.trim();
      if (!query) {
        requestId += 1;
        panel.replaceChildren();
        setExpanded(false);
        return;
      }
      debounceTimer = window.setTimeout(() => {
        void runSearch(query);
      }, 120);
    });

    input.addEventListener('keydown', (event) => {
      const options = [...panel.querySelectorAll<HTMLAnchorElement>('[role="option"]')];
      if (event.key === 'Escape') {
        if (!panel.hidden) {
          event.preventDefault();
          setExpanded(false);
        }
        return;
      }
      if ((event.key === 'ArrowDown' || event.key === 'ArrowUp') && options.length > 0) {
        if (panel.hidden) setExpanded(true);
        event.preventDefault();
        selectResult(moveResultIndex(activeIndex, options.length, event.key === 'ArrowDown' ? 1 : -1));
        return;
      }
      if (event.key === 'Enter' && !panel.hidden && options.length > 0) {
        event.preventDefault();
        options[activeIndex >= 0 ? activeIndex : 0]?.click();
      }
    });

    document.addEventListener('keydown', (event) => {
      const target = event.target instanceof HTMLElement ? event.target : null;
      if (
        !slashShouldFocus({
          key: event.key,
          metaKey: event.metaKey,
          ctrlKey: event.ctrlKey,
          altKey: event.altKey,
          target: target ? { tagName: target.tagName, isContentEditable: target.isContentEditable } : null,
        })
      ) {
        return;
      }
      event.preventDefault();
      input.focus();
    });

    document.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Node && !root.contains(event.target)) setExpanded(false);
    });

    input.addEventListener('focus', () => {
      if (input.value.trim() && panel.childElementCount > 0) setExpanded(true);
    });
  }
</script>
