---
interface Props {
  placeholder: string;
  label: string;
  hint: string;
  footer: string;
  close: string;
}

const { placeholder, label, hint, footer, close } = Astro.props;
---

<div class="docs-search" data-pagefind-ignore>
  <button
    type="button"
    class="docs-search-open"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="docs-search-dialog"
    aria-label={label}
  >
    <svg class="docs-search-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="10.5" cy="10.5" r="6.25" fill="none" stroke="currentColor" stroke-width="2"></circle>
      <path d="M15.2 15.2 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
    </svg>
    <span class="docs-search-open-label">{label}</span>
    <kbd class="docs-search-hint" aria-hidden="true">{hint}</kbd>
  </button>
  <div
    id="docs-search-dialog"
    class="docs-search-dialog"
    role="dialog"
    aria-modal="true"
    aria-label={label}
    hidden
  >
    <div class="docs-search-backdrop"></div>
    <div class="docs-search-modal">
      <button type="button" class="docs-search-close">{close}</button>
      <div class="docs-search-field">
        <label class="visually-hidden" for="docs-search">{label}</label>
        <input
          id="docs-search"
          class="docs-search-input"
          type="search"
          placeholder={placeholder}
          aria-label={label}
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="docs-search-results"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          enterkeyhint="search"
        />
      </div>
      <div id="docs-search-results" class="docs-search-results" hidden></div>
      <p class="docs-search-keys">{footer}</p>
    </div>
  </div>
</div>

<script>
  import { noResultsFor } from '../i18n/ui';
  import { pagefindHasLanguage, urlInLocale } from '../i18n/paths';
  import { moveResultIndex, resultHref, searchRows, slashShouldFocus } from '../lib/docs-search';

  const root = document.querySelector('.docs-search');
  const opener = root?.querySelector('.docs-search-open');
  const dialog = root?.querySelector('.docs-search-dialog');
  const backdrop = root?.querySelector('.docs-search-backdrop');
  const closeButton = root?.querySelector('.docs-search-close');
  const input = root?.querySelector('.docs-search-input');
  const panel = root?.querySelector('.docs-search-results');

  if (
    root instanceof HTMLElement &&
    opener instanceof HTMLButtonElement &&
    dialog instanceof HTMLElement &&
    backdrop instanceof HTMLElement &&
    closeButton instanceof HTMLButtonElement &&
    input instanceof HTMLInputElement &&
    panel instanceof HTMLElement
  ) {
    const PAGE_LIMIT = 8;
    const ROW_LIMIT = 12;
    let pagefindPromise: Promise<PagefindModule> | null = null;
    let requestId = 0;
    let activeIndex = -1;
    let debounceTimer = 0;
    let returnFocus: HTMLElement | null = null;
    let inerted: HTMLElement[] = [];
    let previousOverflow = '';

    type PagefindResult = {
      url: string;
      excerpt: string;
      meta?: { title?: string };
      sub_results?: Array<{ url?: string; title?: string; excerpt?: string }>;
    };

    type PagefindModule = {
      options?: (options: { bundlePath?: string }) => Promise<void>;
      search: (query: string) => Promise<{
        results: Array<{ data: () => Promise<PagefindResult> }>;
      }>;
    };

    function bundleDir(): string {
      const base = import.meta.env.BASE_URL || '/';
      return `${base.endsWith('/') ? base : `${base}/`}pagefind/`;
    }

    function loadPagefind(): Promise<PagefindModule> {
      if (!pagefindPromise) {
        const dir = bundleDir();
        pagefindPromise = import(/* @vite-ignore */ `${dir}pagefind.js`)
          .then(async (mod: { default?: PagefindModule } & Partial<PagefindModule>) => {
            const pagefind = (mod.default ?? mod) as PagefindModule;
            if (pagefind.options) await pagefind.options({ bundlePath: dir });
            return pagefind;
          })
          .catch((error: unknown) => {
            pagefindPromise = null;
            throw error;
          });
      }
      return pagefindPromise;
    }

    function setExpanded(open: boolean) {
      input.setAttribute('aria-expanded', open ? 'true' : 'false');
      panel.hidden = !open;
      if (!open) {
        activeIndex = -1;
        input.removeAttribute('aria-activedescendant');
      }
    }

    function setBackgroundInert(on: boolean) {
      if (!on) {
        for (const el of inerted) el.inert = false;
        inerted = [];
        document.documentElement.style.overflow = previousOverflow;
        return;
      }
      previousOverflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = 'hidden';
      let node: HTMLElement | null = dialog;
      while (node && node !== document.body) {
        const parent = node.parentElement;
        if (!parent) break;
        for (const sibling of parent.children) {
          if (sibling !== node && sibling instanceof HTMLElement && !sibling.inert) {
            sibling.inert = true;
            inerted.push(sibling);
          }
        }
        node = parent;
      }
    }

    function visibleFocusable(): HTMLElement[] {
      return [...dialog.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), input:not([disabled])')].filter(
        (el) => {
          if (el.closest('[hidden]')) return false;
          const style = getComputedStyle(el);
          return style.display !== 'none' && style.visibility !== 'hidden';
        },
      );
    }

    function openDialog() {
      if (dialog.hidden) {
        returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : opener;
        dialog.hidden = false;
        opener.setAttribute('aria-expanded', 'true');
        window.clearTimeout(debounceTimer);
        requestId += 1;
        input.value = '';
        panel.replaceChildren();
        setExpanded(false);
        input.focus();
        setBackgroundInert(true);
      } else {
        input.focus();
      }
    }

    function closeDialog(restoreFocus = true) {
      if (dialog.hidden) return;
      dialog.hidden = true;
      opener.setAttribute('aria-expanded', 'false');
      setBackgroundInert(false);
      if (!restoreFocus) return;
      const back = returnFocus instanceof HTMLElement && document.contains(returnFocus) ? returnFocus : opener;
      back.focus();
    }

    function selectResult(index: number) {
      const options = [...panel.querySelectorAll<HTMLElement>('[role="option"]')];
      activeIndex = index;
      options.forEach((option, optionIndex) => {
        const selected = optionIndex === index;
        option.setAttribute('aria-selected', selected ? 'true' : 'false');
        if (selected) input.setAttribute('aria-activedescendant', option.id);
      });
      options[index]?.scrollIntoView({ block: 'nearest' });
    }

    function renderResults(query: string, results: PagefindResult[]) {
      panel.replaceChildren();
      activeIndex = -1;
      input.removeAttribute('aria-activedescendant');
      const rows = searchRows(results, ROW_LIMIT);

      if (rows.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'docs-search-empty';
        empty.setAttribute('role', 'status');
        empty.textContent = noResultsFor(document.documentElement.lang || 'en', query);
        panel.append(empty);
        setExpanded(true);
        return;
      }

      const list = document.createElement('div');
      list.className = 'docs-search-list';
      list.setAttribute('role', 'listbox');
      const base = import.meta.env.BASE_URL || '/';
      rows.forEach((row, index) => {
        const link = document.createElement('a');
        link.className = 'docs-search-result';
        link.id = `docs-search-result-${index}`;
        link.href = resultHref(row.url, base);
        link.setAttribute('role', 'option');
        link.setAttribute('aria-selected', 'false');

        const title = document.createElement('span');
        title.className = 'docs-search-result-title';
        title.textContent = row.pageTitle;
        link.append(title);

        if (row.section) {
          const section = document.createElement('span');
          section.className = 'docs-search-result-section';
          section.textContent = row.section;
          link.append(section);
        }

        const excerpt = document.createElement('span');
        excerpt.className = 'docs-search-result-excerpt';
        excerpt.innerHTML = row.excerpt;
        link.append(excerpt);

        link.addEventListener('pointermove', () => selectResult(index));
        link.addEventListener('click', () => closeDialog(false));
        list.append(link);
      });
      panel.append(list);
      setExpanded(true);
    }

    async function runSearch(query: string) {
      const id = ++requestId;
      try {
        const lang = document.documentElement.lang || 'en';
        const dir = bundleDir();
        const entryResponse = await fetch(`${dir}pagefind-entry.json`);
        const entry = entryResponse.ok ? ((await entryResponse.json()) as { languages?: Record<string, unknown> }) : null;
        if (!pagefindHasLanguage(entry?.languages, lang)) {
          if (id !== requestId) return;
          renderResults(query, []);
          return;
        }
        const pagefind = await loadPagefind();
        const search = await pagefind.search(query);
        if (id !== requestId) return;
        const data = await Promise.all(search.results.slice(0, PAGE_LIMIT).map((result) => result.data()));
        if (id !== requestId) return;
        renderResults(
          query,
          data.filter((hit) => urlInLocale(hit.url || '', lang, import.meta.env.BASE_URL || '/')),
        );
      } catch (error) {
        if (id !== requestId) return;
        console.error(error);
        panel.replaceChildren();
        setExpanded(false);
      }
    }

    opener.addEventListener('click', () => openDialog());
    backdrop.addEventListener('click', () => closeDialog());
    closeButton.addEventListener('click', () => closeDialog());

    input.addEventListener('input', () => {
      window.clearTimeout(debounceTimer);
      const query = input.value.trim();
      if (!query) {
        requestId += 1;
        panel.replaceChildren();
        setExpanded(false);
        return;
      }
      debounceTimer = window.setTimeout(() => {
        void runSearch(query);
      }, 120);
    });

    input.addEventListener('keydown', (event) => {
      const options = [...panel.querySelectorAll<HTMLAnchorElement>('[role="option"]')];
      if ((event.key === 'ArrowDown' || event.key === 'ArrowUp') && options.length > 0) {
        if (panel.hidden) setExpanded(true);
        event.preventDefault();
        selectResult(moveResultIndex(activeIndex, options.length, event.key === 'ArrowDown' ? 1 : -1));
        return;
      }
      if (event.key === 'Enter' && !panel.hidden && options.length > 0) {
        event.preventDefault();
        options[activeIndex >= 0 ? activeIndex : 0]?.click();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (!dialog.hidden && event.key === 'Escape') {
        event.preventDefault();
        closeDialog();
        return;
      }
      if (!dialog.hidden && event.key === 'Tab') {
        const items = visibleFocusable();
        if (items.length === 0) return;
        const first = items[0];
        const last = items[items.length - 1];
        const active = document.activeElement;
        if (event.shiftKey && (active === first || !dialog.contains(active))) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && (active === last || !dialog.contains(active))) {
          event.preventDefault();
          first.focus();
        }
        return;
      }
      const target = event.target instanceof HTMLElement ? event.target : null;
      if (
        !slashShouldFocus({
          key: event.key,
          metaKey: event.metaKey,
          ctrlKey: event.ctrlKey,
          altKey: event.altKey,
          target: target ? { tagName: target.tagName, isContentEditable: target.isContentEditable } : null,
        })
      ) {
        return;
      }
      event.preventDefault();
      openDialog();
    });
  }
</script>
