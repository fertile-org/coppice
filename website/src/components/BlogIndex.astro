---
import { BLOG_INDEX, formatBlogDate } from '../lib/blog';
import { blogIndexSchema } from '../lib/page-schema';
import { hrefFor, useI18n } from '../i18n/runtime';
import { englishEntries } from '../lib/blog-runtime';
import Base from '../layouts/Base.astro';

const ctx = useI18n(Astro);
const posts = englishEntries().map((entry) => entry.post);
---

<Base title={BLOG_INDEX.title} description={BLOG_INDEX.description} structuredData={blogIndexSchema(Astro, ctx, BLOG_INDEX.description, posts)}>
  <div class="shell landing">
    <header class="promise">
      <h1>{BLOG_INDEX.title}</h1>
      <p class="lede">{BLOG_INDEX.description}</p>
    </header>
    {
      posts.length === 0 ? (
        <p>{BLOG_INDEX.empty}</p>
      ) : (
        <ul class="blog-list">
          {posts.map((post) => (
            <li>
              <a href={hrefFor(ctx.locale, post.englishPath)}>{post.title}</a>
              <time datetime={post.updated ?? post.published}>{formatBlogDate(post.updated ?? post.published)}</time>
              <p>{post.description}</p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>
