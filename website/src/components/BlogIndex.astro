---
import { formatBlogDate, publicPosts } from '../lib/blog';
import { blogIndexSchema } from '../lib/page-schema';
import { hrefFor, useI18n } from '../i18n/runtime';
import { blogEntries } from '../lib/blog-runtime';
import Base from '../layouts/Base.astro';

const ctx = useI18n(Astro);
const posts = publicPosts(
  blogEntries().map((entry) => entry.post),
  ctx.locale,
);
---

<Base
  title={ctx.ui.nav.blog}
  description={ctx.ui.blog.description}
  structuredData={blogIndexSchema(Astro, ctx, ctx.ui.blog.description, posts, ctx.ui.blog.name, ctx.ui.nav.blog)}
>
  <div class="shell landing">
    <header class="promise">
      <h1>{ctx.ui.nav.blog}</h1>
    </header>
    {
      posts.length === 0 ? (
        <p>{ctx.ui.blog.empty}</p>
      ) : (
        <ul class="blog-list">
          {posts.map((post) => (
            <li>
              <a class="blog-list-title" href={hrefFor(ctx.locale, post.englishPath)}>{post.title}</a>
              <time class="blog-list-date" datetime={post.updated ?? post.published}>{formatBlogDate(post.updated ?? post.published, ctx.code)}</time>
              <p>{post.description}</p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>
