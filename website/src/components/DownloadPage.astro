---
import { downloadPageFor } from '../content/downloads';
import { AGENT_CLIS, PRIMARY_KEYWORD } from '../content/agents';
import { pagesFor } from '../i18n/pages';
import { useI18n } from '../i18n/runtime';
import Base from '../layouts/Base.astro';
import { softwareSchema } from '../lib/page-schema';
import { withBase } from '../lib/url';

const ctx = useI18n(Astro);
const copy = pagesFor(ctx.locale).download;
const downloadPage = downloadPageFor(copy);
---

<Base
  title={copy.metaTitle}
  description={copy.description}
  structuredData={softwareSchema(Astro, ctx, copy.description)}
  keywords={[PRIMARY_KEYWORD, ...AGENT_CLIS]}
>
  <div class="shell landing">
    <header class="promise">
      <h1>{downloadPage.title}</h1>
      <p class="lede">{downloadPage.intro}</p>
    </header>

    {
      ctx.locale === 'en' && (
        <p class="download-follow">
          Choose the row for your platform and architecture. Setup steps, including Windows 11 through WSL, are in{' '}
          <a href={withBase('/docs/install')}>Install</a>.
        </p>
      )
    }

    <div class="download-platforms" id="download-platforms">
      {
        downloadPage.groups.map((group) => (
          <div class="download-group" data-os={group.os}>
            {group.rows.map((row) => (
              <div class="download-platform">
                <p>{row.name}</p>
                <span class="download-choice">
                  <a
                    class={row.action.kind === 'button' ? 'btn' : 'text-link'}
                    href={withBase(row.action.href)}
                  >
                    {row.action.label}
                  </a>
                  {ctx.locale === 'en' && row.action.href.includes('#windows-11-through-wsl') && (
                    <span class="download-untested">untested</span>
                  )}
                </span>
              </div>
            ))}
            {group.note && <p class="download-mac-help">{group.note}</p>}
          </div>
        ))
      }
    </div>

    <p class="download-follow">
      {downloadPage.checksum.before}<a href={downloadPage.checksum.sumsHref}>{downloadPage.checksum.sumsLabel}</a
      >{downloadPage.checksum.between}<a href={withBase(downloadPage.checksum.installHref)}>{downloadPage.checksum.installLabel}</a
      >{downloadPage.checksum.after}
    </p>
    <p class="download-follow">
      {downloadPage.next.before}<a href={withBase(downloadPage.next.href)}>{downloadPage.next.label}</a
      >{downloadPage.next.after}
    </p>
  </div>
</Base>

<script>
  import { detectOs, orderOs } from '../content/download-order.ts';

  const root = document.getElementById('download-platforms');
  if (root) {
    for (const os of orderOs(detectOs(navigator.userAgent))) {
      const group = root.querySelector(`[data-os="${os}"]`);
      if (group) root.append(group);
    }
  }
</script>
