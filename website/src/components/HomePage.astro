---
import { AGENT_CLIS, PRIMARY_KEYWORD, SECONDARY_KEYWORD } from '../content/agents';
import { pagesFor } from '../i18n/pages';
import { homeEntry } from '../i18n/pages/en';
import { hrefFor, useI18n } from '../i18n/runtime';
import Base from '../layouts/Base.astro';
import { softwareSchema } from '../lib/page-schema';
import { withBase } from '../lib/url';
import DownloadLinks from './DownloadLinks.astro';
import HeroMedia from './HeroMedia.astro';

const shots = [
  { src: '/home/plan.png', width: 1440, height: 900 },
  { src: '/home/design.png', width: 1440, height: 900 },
  { src: '/home/build.png', width: 1440, height: 900 },
  { src: '/home/review.png', width: 1440, height: 900 },
];

const ctx = useI18n(Astro);
const copy = pagesFor(ctx.locale).home;
---

<Base
  title={copy.title}
  description={copy.description}
  structuredData={softwareSchema(Astro, ctx, copy.description)}
  keywords={[PRIMARY_KEYWORD, SECONDARY_KEYWORD, ...AGENT_CLIS]}
>
  <div class="shell landing">
    <header class="promise">
      <h1>{copy.h1}</h1>
      <p class="lede">{copy.lede}</p>
    </header>

    <HeroMedia stillAlt={copy.hero.stillAlt} videoAlt={copy.hero.videoAlt} />

    <p class="hero-support">{copy.support}</p>

    <div id="download">
      <DownloadLinks showDocs mac={copy.downloads.mac} linux={copy.downloads.linux} docs={copy.downloads.docs} />
    </div>

    <p class="works-with">
      {copy.worksWith} <a href={hrefFor(ctx.locale, '/docs/providers')}>{AGENT_CLIS.join(' · ')}</a>
    </p>

    {
      ctx.locale === 'en' && (
        <section class="block" aria-labelledby="what-coppice-is">
          <h2 id="what-coppice-is">{homeEntry.whatTitle}</h2>
          <p>
            {homeEntry.whatBody} {homeEntry.learnBefore}
            <a href={hrefFor(ctx.locale, '/docs/getting-started')}>{homeEntry.learnLabel}</a>
            {homeEntry.learnAfter}
          </p>
        </section>
      )
    }

    <section class="block" aria-labelledby="how-it-works">
      <h2 id="how-it-works">{copy.howTitle}</h2>
      <ol class="how-steps">
        {
          copy.steps.map((step, index) => (
            <li class="how-step">
              <img
                src={withBase(shots[index].src)}
                width={shots[index].width}
                height={shots[index].height}
                alt={step.imageAlt}
                loading="lazy"
                decoding="async"
              />
              <div class="how-step-copy">
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p>{copy.howClose}</p>
    </section>

    <section class="block" aria-labelledby="why">
      <h2 id="why">{copy.whyTitle}</h2>
      <div class="feature-grid">
        {
          copy.reasons.map((reason) => (
            <article>
              <h3>{reason.title}</h3>
              <p>{reason.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="block pair-follow" aria-labelledby="what-it-is-not">
      <h2 id="what-it-is-not">{copy.notTitle}</h2>
      <ul class="plain-list">
        {copy.notItems.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </div>
</Base>
