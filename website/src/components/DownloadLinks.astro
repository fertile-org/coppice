---
import { withBase } from '../lib/url';

interface Props {
  showDocs?: boolean;
  mac: string;
  linux: string;
  docs: string;
}

const { showDocs = false, mac, linux, docs } = Astro.props;
const downloadHref = withBase('/download');
---

<div class="download-row">
  <a class="btn" href={downloadHref}>{mac}</a>
  <a class="btn btn-secondary" href={downloadHref}>{linux}</a>
  {showDocs && <a class="text-link" href={withBase('/docs')}>{docs}</a>}
</div>
