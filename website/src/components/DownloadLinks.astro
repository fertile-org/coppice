---
import { withBase } from '../lib/url';

interface Props {
  showDocs?: boolean;
}

const { showDocs = false } = Astro.props;

// Bump `version` on each release. Point these at the GitHub Release
// assets only — macOS arm64 .dmg and Linux amd64 .deb:
//   Coppice-<version>-mac-arm64.dmg
//   Coppice-<version>-linux-amd64.deb
// Do not add Windows, macOS Intel, or Linux arm64 links.
const version = '0.1.0-rc.7';
const tag = 'v' + version;
const releaseBase = `https://github.com/fertile-org/coppice/releases/download/${tag}`;
const macHref = `${releaseBase}/Coppice-${version}-mac-arm64.dmg`;
const linuxHref = `${releaseBase}/Coppice-${version}-linux-amd64.deb`;
---

<div class="download-row">
  <a class="btn" href={macHref}>Download for macOS (Apple Silicon)</a>
  <a class="btn btn-secondary" href={linuxHref}>Download for Linux (.deb)</a>
  {showDocs && <a class="text-link" href={withBase('/docs')}>Read the docs</a>}
</div>
