---
import { withBase } from '../lib/url';

interface Props {
  showDocs?: boolean;
}

const { showDocs = false } = Astro.props;
const downloadHref = withBase('/download');
---

<div class="download-row">
  <a class="btn" href={downloadHref}>Download for macOS (Apple Silicon)</a>
  <a class="btn btn-secondary" href={downloadHref}>Download for Linux (.deb)</a>
  {showDocs && <a class="text-link" href={withBase('/docs')}>Read the docs</a>}
</div>
