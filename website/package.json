{
  "name": "coppice-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-search-index.mjs",
    "check:search": "node --experimental-strip-types --test src/lib/docs-search.test.ts",
    "preview": "astro preview --host 127.0.0.1",
    "check:links": "node scripts/check-links.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:download": "node --experimental-strip-types --test src/content/downloads.test.ts",
    "check:download-page": "node scripts/check-download-page.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:code": "node scripts/check-code-blocks.mjs",
    "check:placeholders": "node scripts/check-doc-placeholders.mjs",
    "check:i18n": "node --experimental-strip-types --test src/i18n/i18n.test.ts && node scripts/check-i18n.mjs",
    "og:image": "node scripts/make-og-image.mjs",
    "web:images": "node scripts/make-web-images.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.3.5",
    "astro-pagefind": "^2.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.55.1",
    "sharp": "^0.35.5"
  }
}
