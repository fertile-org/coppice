{
  "name": "coppice-desktop",
  "productName": "Coppice",
  "private": true,
  "version": "0.1.0",
  "description": "Run a team of coding agents without babysitting them. Coppice runs on your computer with the agent CLIs you already pay for, like Claude Code and Codex. No Coppice account, no Docker.",
  "homepage": "https://getcoppice.vercel.app/",
  "license": "Apache-2.0",
  "author": {
    "name": "Coppice Maintainers",
    "email": "coppice@users.noreply.github.com"
  },
  "main": "main.mjs",
  "desktopName": "coppice.desktop",
  "coppice": {
    "releaseRepo": "fertile-org/coppice"
  },
  "scripts": {
    "start": "ELECTRON_DISABLE_SANDBOX=1 electron .",
    "fetch-postgres": "node scripts/fetch-postgres.mjs",
    "assemble": "node scripts/assemble-resources.mjs",
    "dist": "node scripts/dist.mjs",
    "dist:dir": "node scripts/dist.mjs --dir",
    "smoke:headless": "node scripts/headless-smoke.mjs",
    "test": "node --test 'test/*.test.mjs' electron-smoke.test.mjs"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "26.15.3"
  }
}
